{
    "builds": [
        {
            "src": "alphaplatform/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "50mb",
                "runtime": "python3.12",
                "buildCommand": "bash setup.sh"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "alphaplatform/wsgi.py"
        }
    ],
    "crons": [
        {
            "path": "/cron/cleanup/",
            "schedule": "0 3 * * *"
        }
    ]
}
