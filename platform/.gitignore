# Django
db.sqlite3
media/

# staticfiles/ is intentionally committed, not ignored — Vercel's build
# does not reliably run `collectstatic`, so the pre-built output is what
# actually gets served at /static/. Regenerate and commit it after any
# change to CSS/JS/images under static/.

# Vercel
.vercel/

# OS / editor
.DS_Store
.vscode/

# Raw third-party reference templates — source material we build fresh
# Django templates from, never deployed or committed as-is.
_reference_templates/
