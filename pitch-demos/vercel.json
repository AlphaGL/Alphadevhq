{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    { "source": "/(.*)\\.(jpg|png|svg|woff2)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.(css|js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
